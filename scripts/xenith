#!/usr/bin/env bash
#
# Host-side wrapper around the Xenith container.
#
#   xenith up | down | restart | status | logs | update
#   xenith cli admin create --sudo
#   xenith certbot certificates
#   xenith shell
#
# Installed to /usr/local/bin/xenith by scripts/install.sh.

set -euo pipefail

INSTALL_DIR="${XENITH_DIR:-/opt/xenith}"
COMPOSE_FILE="$INSTALL_DIR/docker-compose.yml"
SERVICE=xenith

die() { printf '\033[1;31m error\033[0m %s\n' "$*" >&2; exit 1; }

[[ -f "$COMPOSE_FILE" ]] || die "No installation found at $INSTALL_DIR (set XENITH_DIR to point elsewhere)."

compose() { docker compose -f "$COMPOSE_FILE" "$@"; }

usage() {
  cat <<USAGE
Xenith

  xenith up               Start the panel
  xenith down             Stop it
  xenith restart          Restart it (do this after changing .env)
  xenith status           Container state
  xenith logs [-f]        Panel logs
  xenith update           Rebuild from the latest sources and restart
  xenith cli <args>       Run xenith-cli inside the container
  xenith certbot <args>   Run certbot inside the container
  xenith shell            Shell inside the container
  xenith env              Open $INSTALL_DIR/.env in \$EDITOR
USAGE
}

command="${1:-}"
[[ $# -gt 0 ]] && shift || true

case "$command" in
  up)      compose up -d ;;
  down)    compose down ;;
  restart) compose restart ;;
  status)  compose ps ;;
  logs)    compose logs "${@:---tail=200}" ;;
  cli)     compose exec "$SERVICE" xenith-cli "$@" ;;
  certbot) compose exec "$SERVICE" certbot "$@" ;;
  shell)   compose exec "$SERVICE" bash ;;
  env)     "${EDITOR:-nano}" "$INSTALL_DIR/.env" ;;
  update)
    if [[ -d "$INSTALL_DIR/src/.git" ]]; then
      git -C "$INSTALL_DIR/src" fetch --depth 1 origin main
      git -C "$INSTALL_DIR/src" checkout -q FETCH_HEAD
      docker build -t "$(awk '/image:/ {print $2; exit}' "$COMPOSE_FILE")" "$INSTALL_DIR/src"
    else
      compose pull
    fi
    compose up -d
    ;;
  ""|help|-h|--help) usage ;;
  *) die "Unknown command: $command (try: xenith help)" ;;
esac
